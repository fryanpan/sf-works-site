{
 "about": "Year-by-year match of police-reported severe injuries and deaths (DataSF nwes-mmgh) against SFDPH's published hospital counts (ZSFG trauma registry) and OME-verified deaths, 2015-2024, by mode where SFDPH gives it.",
 "caveats": [
  "A ratio of two counts, not a linkage rate.",
  "ZSFG severe includes freeways, the Presidio and off-street rail; police and OME exclude highways, so each ratio understates the police share of the same population, most for 'everyone else'.",
  "SFDPH counts e-scooter riders as pedestrians; see pedestrian_with_police_scooter_riders.",
  "ZSFG severe leaves out deaths; dph_ksi_zsfg_plus_ome adds OME deaths to it.",
  "our_police_ksi_per_linked_total compares police KSI before reclassification with SFDPH's linked total after it."
 ],
 "sources": {
  "zsfg_and_dph_police": "SFDPH, San Francisco Severe Traffic Injury Trends: 2015-2022 (December 2024), https://visionzerosf.org/wp-content/uploads/2024/12/Severe-Injury-Trends_2015-2022.pdf [primary — read 2026-11-25]",
  "zsfg_earlier_edition": "SFDPH, Severe Injury Trends 2011-2020, Tables 1 and A, https://media.api.sf.gov/documents/Severe-Injury-Trends_2011-2020_final_report.cleaned_GmPU6Ay.pdf [primary — read 2026-11-25]; same 2015-2020 figures as the 2015-2022 report",
  "linkage": "SFDPH and SFMTA, Vision Zero High Injury Network: 2022 Update, methodology, Tables 3, 4 and 6, https://www.visionzerosf.org/wp-content/uploads/2023/03/2022_Vision_Zero_Network_Update_Methodology.pdf [primary — read 2026-11-25]",
  "deaths": "DataSF dau3-4s8f, Traffic Crashes Resulting in Fatality, https://data.sfgov.org/d/dau3-4s8f [DataSF dau3-4s8f — queried 2026-11-25]"
 },
 "inputs": {

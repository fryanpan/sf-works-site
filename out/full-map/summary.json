  "tthird": {
   "label": "T Third every 5 minutes, Sunnydale to Chinatown in about 35 minutes (assumed)",
   "ruling": "Bryan, 2026-10-23: \"Add it\" (docs/decisions/access-map.md)",
   "file": "out/full-map/transit-tthird.json",
   "note": "Muni or walking, whichever is faster, with the scenario's feed in place of SFMTA's; every number in assumptions is assumed, not measured. within: residents within N minutes. gains: per type, residents and blocks whose time is lower than the base map's (faster), higher (slower), or newly within 15 or 30 minutes. faster_by_zip: the faster residents and blocks per type by 2020 ZIP Code Tabulation Area (by the block's interior point; null for the few blocks whose point falls in no ZCTA).",
   "assumptions": {
    "end_to_end_min": {
     "assumption": true,
     "value": 35.0,
     "why": "Sunnydale to Chinatown in about 35 minutes (the feed's peak trips take 45 to 48), roughly what full signal priority would give"

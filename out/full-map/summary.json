    "headway_min": {
     "assumption": true,
     "value": 5,
     "why": "a T every 5 minutes all day, both directions (the feed runs every 10 in the AM peak)"
    },
    "pattern": {
     "assumption": true,
     "value": "every trip full length; the feed's short turns removed"
    },
    "scaling": {
     "assumption": true,
     "value": "proportional",
     "why": "every stop-to-stop time and dwell scaled by end_to_end_min over the template's duration"
    },
    "span": {
     "assumption": true,
     "value": "the feed's first to last T departure that day, per direction"
    }
